---
import '../styles/site.css';
import '../styles/search.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const { title, description = SITE.description, image, type = 'website', jsonLd } = Astro.props;

const fullTitle = !title
  ? `${SITE.title} : Senior Lead Engineer | Project Leader`
  : title.includes(SITE.title) ? title : `${title} | ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ?? new URL(SITE.logo, Astro.site).href;
const desc = description.replace(/\s+/g, ' ').trim().slice(0, 300);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={SITE.logo} type="image/png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/index.xml" />
    <link rel="preload" href="/fonts/Atkinson-Hyperlegible-Regular-102a.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/eb-garamond-v14-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
    <script>
      import '../scripts/site.js';
      import '../scripts/search.js';
    </script>
  </body>
</html>
