---
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-in">
    <p style="margin:0">© {year} {SITE.author}, France</p>
    <nav class="footer-links" aria-label="Liens du pied de page">
      {SITE.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="icon-link" href={SITE.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn"><Icon name="linkedin" size={22} /></a>
  </div>
</footer>
