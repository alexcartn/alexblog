---
import type { Term } from '../lib/content';
interface Props { terms: Term[]; base: string; current?: string }
const { terms, base, current } = Astro.props;
---
<div class="terms">
  {terms.map((t) => <a class="chip" href={`/${base}/${t.slug}/`} aria-current={t.slug === current ? 'page' : undefined}>{t.name} <small>{t.items.length}</small></a>)}
</div>
