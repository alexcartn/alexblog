---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('src/content/pages/about/index.md est introuvable');
const { Content } = await render(page);
const d = page.data;
---
<Base title={d.title} description={d.description ?? undefined}>
  <header class="page-head wrap"><h1>{d.heading ?? d.title}</h1></header>
  <div class="about-grid">
    <div class="prose"><Content /></div>
    <aside class="profile">
      {d.avatar && <Image src={d.avatar} width={256} height={256} format="webp" alt="Portrait illustré d'Alexandre Carton" />}
      <h2>{d.author}</h2>
      <p class="role">{d.role}</p>
      <a class="btn ghost" href={SITE.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" size={18} /> LinkedIn</a>
      {d.interests.length > 0 && (
        <div class="interests">
          <p class="interests-label">Centres d'intérêt</p>
          <p>{d.interests.join(' · ')}</p>
        </div>
      )}
    </aside>
  </div>
</Base>
